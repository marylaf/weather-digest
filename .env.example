# Express API
PORT=3000
NODE_ENV=development

# Уровень структурированных логов: trace, debug, info, warn, error, fatal, silent.
# Если не задан: debug в development, info в production.
LOG_LEVEL=debug

# Сколько миллисекунд ждать активные запросы при SIGTERM и SIGINT.
SHUTDOWN_TIMEOUT_MS=10000

# JWT. Access token живёт недолго, refresh token кладётся в HttpOnly cookie.
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Cookie refresh-токена. Для http://localhost Secure должен быть false.
# COOKIE_SAMESITE: lax, strict или none. none требует COOKIE_SECURE=true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS: явный список origin через запятую. Нельзя использовать "*"
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limit для /api
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Максимальный размер JSON body
JSON_BODY_LIMIT=100kb

# Параметры для локального запуска CLI и docker compose
# Города через запятую (аналог --city)
CITY=Москва,Казань,Сочи

# Число дней прогноза, 1–7 (аналог --days)
DAYS=3

# true/1 — не читать кэш отчётов (аналог --no-cache)
NO_CACHE=false

# Геокодинг: GET {GEOCODING_URL}?name={город}&count=1&language=ru&format=json
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Прогноз: GET {FORECAST_URL}?latitude={lat}&longitude={lon}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum,wind_speed_10m_max&forecast_days={n}&timezone=auto
FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Таймаут исходящих HTTP-запросов в миллисекундах (REQUEST_TIMEOUT_MS имеет приоритет)
TIMEOUT_MS=5000
REQUEST_TIMEOUT_MS=5000

# Порог скорости ветра для наружных работ: metric — м/с, imperial — mph
MAX_WIND_SPEED=10

# Каталог для сохранения отчётов
REPORTS_DIR=./reports

# Единицы измерения: metric (°C, мм) или imperial (°F, in)
UNITS=metric

EQUIPMENT_FILE=./data/equipment.json
REQUESTS_FILE=./data/requests.json

# PostgreSQL. Миграции и сиды идут от владельца схемы.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weather_digest
DB_USER=weather_digest
DB_PASSWORD=change_me

# Роль приложения: чтение и запись рабочих таблиц, в журнал статусов только INSERT.
# UPDATE и DELETE по request_status_history этой роли не выданы.
DB_APP_USER=weather_digest_app
DB_APP_PASSWORD=change_me_app

# Пул Sequelize
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

GRAFANA_ADMIN_PASSWORD=change_me_grafana
