# Геокодинг: GET {GEOCODING_URL}?name={город}&count=1&language=ru&format=json
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# Прогноз: GET {FORECAST_URL}?latitude={lat}&longitude={lon}&daily=temperature_2m_max,temperature_2m_min,precipitation_sum&forecast_days={n}&timezone=auto
FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Таймаут HTTP-запросов в миллисекундах
TIMEOUT_MS=10000
