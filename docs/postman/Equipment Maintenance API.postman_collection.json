      "name": "Security",
      "item": [
        {
          "name": "Rate Limit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 429\", () => {",
                  "  pm.response.to.have.status(429);",
                  "});",
                  "",
                  "pm.test(\"Rate limit response has error structure\", () => {",
                  "  const body = pm.response.json();",
                  "",
                  "  pm.expect(body).to.have.property(\"error\");",
                  "  pm.expect(body.error.code).to.eql(\"RATE_LIMIT_EXCEEDED\");",
                  "  pm.expect(body.error).to.have.property(\"message\");",
                  "  pm.expect(body.error).to.have.property(\"requestId\");",
                  "});",
                  "",
                  "pm.test(\"Rate limit headers are present\", () => {",
                  "  const names = pm.response.headers.all().map((header) => header.key.toLowerCase());",
                  "  const hasLimit = names.some((name) => name === \"ratelimit\" || name === \"ratelimit-limit\" || name === \"ratelimit-policy\");",
                  "  pm.expect(hasLimit).to.be.true;",
                  "});"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.collectionVariables.get(\"baseUrl\") || \"http://localhost:3000\";",
                  "const burst = Number(pm.collectionVariables.get(\"rateLimitBurst\") || 110);",
                  "",
                  "for (let i = 0; i < burst; i += 1) {",
                  "  await new Promise((resolve) => {",
                  "    pm.sendRequest(",
                  "      { url: `${baseUrl}/api/health`, method: \"GET\" },",
                  "      () => resolve()",
                  "    );",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            }
          },
          "response": []
        }
      ],
      "description": "Запускать последней группой. Pre-request делает {{rateLimitBurst}} вызовов /api/health, затем сам запрос должен получить 429. При RATE_LIMIT_MAX=1 достаточно burst=2."
    }
